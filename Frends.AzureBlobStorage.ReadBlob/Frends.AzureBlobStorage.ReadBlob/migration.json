[
  {
    "Task": "Frends.AzureBlobStorage.ReadBlob",
    "Migrations": [
      {
        "Version": "2.0.0",
        "Description": "Moved authentication parameters from Source tab to Connection tab and converted URI-based account input to storage account name.",
        "Migration": [
          {
            "Type": "Map",
            "Source": "Source.AuthenticationMethod",
            "Target": "Connection.AuthenticationMethod",
            "Maps": {
              "ConnectionString": "ConnectionString",
              "SASToken": "SasToken"
            }
          },
          {
            "Type": "Copy",
            "Source": "Source.ConnectionString",
            "Target": "Connection.ConnectionString"
          },
          {
            "Type": "Copy",
            "Source": "Source.ApplicationID",
            "Target": "Connection.ApplicationId"
          },
          {
            "Type": "Copy",
            "Source": "Source.TenantID",
            "Target": "Connection.TenantId"
          },
          {
            "Type": "Copy",
            "Source": "Source.ClientSecret",
            "Target": "Connection.ClientSecret"
          },
          {
            "Type": "Copy",
            "Source": "Source.SASToken",
            "Target": "Connection.SasToken"
          },
          {
            "Type": "Copy",
            "Source": "Source.StorageAccountName",
            "Target": "Connection.StorageAccountName"
          },
          {
            "Type": "RegexMap",
            "Source": "Source.URI",
            "Target": "Connection.StorageAccountName",
            "Maps": {
              "^https?://([^./?]+)\\.blob\\.core\\.windows\\.net.*$": "$1"
            }
          }
        ]
      }
    ]
  }
]

